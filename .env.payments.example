# Платёжный слой ARASILVER — плейсхолдеры (значения получишь у банка/Idram).
# Скопируй нужные строки в .env.local. Секреты в код НЕ коммитим.

# --- Общее ---
# Базовый публичный URL сайта (для returnUrl/колбэков банка). Без слэша на конце.
NEXT_PUBLIC_SITE_URL=https://arasilver.am

# Service-role ключ Supabase — нужен вебхукам для записи статуса оплаты
# в обход RLS. ТОЛЬКО на сервере, НИКОГДА не в клиентский код.
SUPABASE_SERVICE_ROLE_KEY=

# --- ArCa (онлайн-эквайринг через банк) ---
ARCA_API_URL=
ARCA_USERNAME=
ARCA_PASSWORD=

# --- Idram ---
IDRAM_MERCHANT_ID=
IDRAM_SECRET_KEY=
